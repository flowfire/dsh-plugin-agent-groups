{
  "name": "dsh-plugin-agent-groups",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "把多个现有 DSH 会话拉进一个协作群，按时间线自动转达彼此的最终输出。",
  "license": "MIT",
  "author": "flowfire",
  "homepage": "https://github.com/flowfire/dsh-plugin-agent-groups#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowfire/dsh-plugin-agent-groups.git"
  },
  "bugs": {
    "url": "https://github.com/flowfire/dsh-plugin-agent-groups/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "multi-agent",
    "collaboration",
    "group-chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}